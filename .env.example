OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cuántas noticias tomar por feed (ordenadas por fecha, más recientes primero)
NOTICIAS_POR_FEED=1

# Máx. caracteres del cuerpo enviados al LLM por noticia
MAX_CONTEXTO_NOTICIA=1000

# Edad máxima de una noticia (días). 0 = sin límite.
# Filtra entradas viejas mezcladas en el feed.
MAX_EDAD_DIAS=7

# Timeout para cada request a Ollama (segundos)
OLLAMA_TIMEOUT=150
